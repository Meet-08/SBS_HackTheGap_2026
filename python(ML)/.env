# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Cache TTL (Time To Live) in seconds
# Soil data changes rarely - cache for 30 days (2592000 seconds)
SOIL_CACHE_TTL=2592000
# Weather data - cache for 24 hours (86400 seconds) for current year
WEATHER_CACHE_TTL=86400
# Historical weather data - cache for 7 days (604800 seconds)
HISTORICAL_WEATHER_CACHE_TTL=604800
